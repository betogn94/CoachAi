{
  "name": "coachai",
  "version": "1.0.0",
  "scripts": {
    "qa": "node qa/run.js",
    "qa:local": "node qa/run.js --base http://localhost:3030 --personas testb --verbose",
    "qa:prod": "node qa/run.js --base https://coach-ai-pearl.vercel.app --personas testb --verbose",
    "test:parsers": "node scripts/test-parsers.mjs",
    "setup:hooks": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "test:semanas": "node scripts/test-semanas.mjs",
    "chat:cerebro": "node scripts/build-chat-prompt.mjs",
    "chat:cerebro:check": "node scripts/build-chat-prompt.mjs --check",
    "theme:brand": "node scripts/build-theme-brand.mjs",
    "theme:brand:check": "node scripts/build-theme-brand.mjs --check",
    "studio:parsers": "node scripts/build-studio-parsers.mjs",
    "studio:parsers:check": "node scripts/build-studio-parsers.mjs --check",
    "test:studio-gate": "node scripts/test-studio-gate.mjs",
    "test:chat-message": "node scripts/test-chat-message.mjs && node scripts/test-chat-message-handler.mjs && node scripts/test-chat-message-planes.mjs",
    "test:cierre-semana": "node scripts/test-cierre-semana.mjs",
    "test:plan-generate": "node scripts/test-plan-generate.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "resend": "^4.0.0",
    "stripe": "^17.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "puppeteer-core": "^25.1.0"
  }
}
